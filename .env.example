# ==============================================================================
# CloudLab Environment Configuration (Express.js Edition)
# ==============================================================================

NODE_ENV=development

# Infrastructure
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=cloudlab
DATABASE_PASSWORD=cloudlabpassword
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_URL=amqp://cloudlab:cloudlabpassword@localhost:5672

# Service Ports
GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4001
LEARNING_SERVICE_PORT=4002
CHALLENGE_SERVICE_PORT=4003
PROGRESS_SERVICE_PORT=4004
FRONTEND_PORT=5173

# Service URLs (for API Gateway proxying)
AUTH_SERVICE_URL=http://localhost:4001
LEARNING_SERVICE_URL=http://localhost:4002
CHALLENGE_SERVICE_URL=http://localhost:4003
PROGRESS_SERVICE_URL=http://localhost:4004

# JWT Secrets & Security
JWT_SECRET=super-secret-cloudlab-jwt-access-key-development-only-replace-in-prod
JWT_EXPIRATION=900s
JWT_REFRESH_SECRET=super-secret-cloudlab-jwt-refresh-key-development-only-replace-in-prod
JWT_REFRESH_EXPIRATION=7d
INTERNAL_API_SECRET=cloudlab-internal-gateway-secret-token

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:4000/api/v1
FRONTEND_URL=http://localhost:5173

# App
APP_NAME=CloudLab

# ==============================================================================
# Email (Gmail SMTP)
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Create an App Password (select "Mail" + your device)
# 3. Paste the 16-char app password below (no spaces)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="CloudLab <your-gmail@gmail.com>"
